{
    "name": "@skillz/api",
    "version": "0.1.0",
    "type": "module",
    "private": true,
    "main": "./src/index.ts",
    "scripts": {
        "dev": "wrangler dev",
        "deploy": "wrangler deploy",
        "db:migrate": "wrangler d1 migrations apply DB --local",
        "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
        "db:seed": "wrangler d1 execute DB --local --file=../../packages/db/seed.sql",
        "test": "vitest",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@skillz/db": "workspace:*",
        "@skillz/shared": "workspace:*",
        "better-auth": "^1.3.34",
        "drizzle-orm": "^0.36.4",
        "hono": "^4.6.16"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20241127.0",
        "@eslint/js": "^9.17.0",
        "eslint": "^9.17.0",
        "typescript": "^5.7.2",
        "typescript-eslint": "^8.18.2",
        "vitest": "^2.1.8",
        "wrangler": "^3.94.0"
    }
}