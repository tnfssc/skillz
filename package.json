{
  "name": "skillz",
  "version": "0.1.0",
  "private": true,
  "description": "Package manager for Claude Skills",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @skillz/api dev",
    "dev:web": "pnpm --filter @skillz/web dev",
    "dev:all": "pnpm --parallel dev",
    "build": "pnpm --recursive build",
    "build:cli": "cd cli && go build -o ../dist/skillz ./cmd/skillz",
    "deploy": "pnpm --filter @skillz/api deploy",
    "deploy:web": "pnpm --filter @skillz/web deploy",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "pnpm --recursive lint",
    "test": "CI=true pnpm --recursive test"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251121.0",
    "typescript": "^5.9.3",
    "wrangler": "^4.50.0"
  },
  "packageManager": "pnpm@10.23.0"
}
