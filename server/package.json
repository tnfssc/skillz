{
  "name": "@skillz/api",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "dev:css": "tailwindcss -i ./src/styles.css -o ./public/static/style.css --watch",
    "build:css": "tailwindcss -i ./src/styles.css -o ./public/static/style.css",
    "deploy": "npm run build:css && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate": "wrangler d1 migrations apply DB --remote",
    "db:seed": "wrangler d1 execute DB --local --file=./db/seed.sql",
    "test": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@cloudflare/ai": "^1.2.2",
    "@cloudflare/workers-types": "^4.20251121.0",
    "@eslint/js": "^9.39.1",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.35.6",
    "autoprefixer": "^10.4.22",
    "base64-js": "^1.5.1",
    "better-auth": "^1.3.34",
    "drizzle-orm": "^0.44.7",
    "eslint": "^9.39.1",
    "hono": "^4.10.6",
    "mustache": "^4.2.0",
    "postcss": "^8.5.6",
    "prettier": "^3.6.2",
    "tailwindcss": "^3.4.18",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.47.0",
    "vitest": "^4.0.13",
    "wrangler": "^4.50.0"
  },
  "packageManager": "pnpm@10.23.0"
}
